*.ckpt
runs/
wandb/

# --- SLURM logs ---
slurm-*.out
slurm-*.err

# --- Archives used to move code to the cluster ---
*.tgz
*.tar.gz

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
